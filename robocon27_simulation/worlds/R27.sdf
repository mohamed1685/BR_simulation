    <model name="blue_ramp">
      <static>true</static>
      <pose>-1.5 7.2 0.001 0 0 -1.5708</pose>
      <link name="link">
        <!-- Box collision proxy for the wedge mesh (raw trimesh collision caused flips); pitch is negative to match the mesh's low->high slope direction.
             Extended 0.15m past the mesh's low end and re-centered so the plate is embedded ~2.5cm into the ground there instead of meeting it at an exact
             zero-thickness seam. A wheel's first contact right at a knife-edge boundary between two separate static collisions is a known source of bad/
             erratic contact normals in ODE, which can kick the robot and flip it - this removes that edge case by giving continuous overlap instead. -->
        <collision name="collision">
          <pose>1.6761 0.5 0.2873 0 -0.16978 0</pose>
          <geometry>
            <box>
              <size>3.7011 1.0 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.65</mu>
                <mu2>0.65</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>meshes/ramp.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.5098039215686274 0.7058823529411765 0.7843137254901961 1</ambient>
            <diffuse>0.5098039215686274 0.7058823529411765 0.7843137254901961 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
