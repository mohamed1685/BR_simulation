<?xml version="1.0"?>
<!--
  Generated by tools/generate_urdf.py from cad_export/solidworks_export.urdf and meshes/*.STL.  Do not hand-edit.
  Frames: every link frame is axis-aligned with base_link (X forward, Y left, Z up) and sits on its own axle.
  base_link origin = geometric (bounding-box) centre of base_link.STL; the floor is 0.3335 m below it.
  All wheel / due joints rotate about +Y: a POSITIVE velocity drives the robot FORWARD (+X).
-->
<robot name="due_wheel" xmlns:gz="http://gazebosim.org/schema">

  <!-- ============================== BASE ============================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.002969 0.000016 0.125793" rpy="0 0 0"/>
      <mass value="22"/>
      <inertia ixx="0.859399" ixy="-0.00009" ixz="-0.020858" iyy="0.820264" iyz="0.000097" izz="1.092501"/>
    </inertial>
    <visual>
      <origin xyz="0.781913 -1.529063 -1.28654" rpy="0 0 3.141593"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/base_link.STL"/></geometry>
      <material name="base_mat"><color rgba="0.792 0.820 0.933 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.781913 -1.529063 -1.28654" rpy="0 0 3.141593"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/base_link.STL"/></geometry>
    </collision>
  </link>

  <!-- ============================== WHEEL front_left (1normalwheelf.STL) ============================== -->
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="-0.000025 0.000091 0.000014" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.001371" ixy="0" ixz="0" iyy="0.001977" iyz="0" izz="0.001371"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03437 0" rpy="-1.570796 1.551185 0"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/1normalwheelf.STL"/></geometry>
      <material name="front_left_wheel_mat"><color rgba="0.25 0.25 0.28 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.0635" length="0.0687"/></geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.205777 0.297999 -0.27" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="60"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ============================== WHEEL front_right (2normalwheelf.STL) ============================== -->
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0.000017 0.000091 0.000023" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.001371" ixy="0" ixz="0" iyy="0.001977" iyz="0" izz="0.001371"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03437 0" rpy="1.570796 -0.127518 3.141593"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/2normalwheelf.STL"/></geometry>
      <material name="front_right_wheel_mat"><color rgba="0.25 0.25 0.28 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.0635" length="0.0687"/></geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.205777 -0.298001 -0.27" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="60"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ============================== WHEEL rear_left (1normalwheelb.STL) ============================== -->
  <link name="rear_left_wheel">
    <inertial>
      <origin xyz="0.000025 0.000091 -0.000014" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.001371" ixy="0" ixz="0" iyy="0.001977" iyz="0" izz="0.001371"/>
    </inertial>
    <visual>
      <origin xyz="0 0.000001 0" rpy="-1.570796 -1.570796 0"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/1normalwheelb.STL"/></geometry>
      <material name="rear_left_wheel_mat"><color rgba="0.25 0.25 0.28 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.0635" length="0.0687"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.198022 0.297999 -0.27" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="60"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ============================== WHEEL rear_right (2wheelnormalbac.STL) ============================== -->
  <link name="rear_right_wheel">
    <inertial>
      <origin xyz="0.000006 0.000091 0.000028" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.001371" ixy="0" ixz="0" iyy="0.001977" iyz="0" izz="0.001371"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03437 0" rpy="1.570796 0.310667 3.141593"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/2wheelnormalbac.STL"/></geometry>
      <material name="rear_right_wheel_mat"><color rgba="0.25 0.25 0.28 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry><cylinder radius="0.0635" length="0.0687"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.198022 -0.298001 -0.27" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="60"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ============================== front_due (frontdue.STL) ============================== -->
  <link name="front_due">
    <inertial>
      <origin xyz="0 0.22 0" rpy="0 0 0"/>
      <mass value="2"/>
      <inertia ixx="0.090952" ixy="0" ixz="0.000773" iyy="0.021959" iyz="0" izz="0.111715"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0.431551 3.141593"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/frontdue.STL"/></geometry>
      <material name="front_due_mat"><color rgba="0.75 0.75 0.75 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0.431551 3.141593"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/frontdue.STL"/></geometry>
    </collision>
  </link>
  <joint name="front_due_joint" type="continuous">
    <origin xyz="0.132775 -0.22 -0.261273" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_due"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="30"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- ============================== back_due (backduewheels.STL) ============================== -->
  <link name="back_due">
    <inertial>
      <origin xyz="0 0.085 0" rpy="0 0 0"/>
      <mass value="2"/>
      <inertia ixx="0.012749" ixy="0" ixz="0.001613" iyy="0.021959" iyz="0" izz="0.033318"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0.390922 3.141593"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/backduewheels.STL"/></geometry>
      <material name="back_due_mat"><color rgba="0.75 0.75 0.75 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0.390922 3.141593"/>
      <geometry><mesh filename="package://robocon27_simulation/meshes/backduewheels.STL"/></geometry>
    </collision>
  </link>
  <joint name="back_due_joint" type="continuous">
    <origin xyz="-0.257216 -0.085 -0.258144" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_due"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="30"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- ============================== GAZEBO ============================== -->
  <!-- Mecanum rollers are not modelled; instead each wheel has anisotropic friction:
       grip (mu) along fdir1 = roller axis on the ground, free rolling (mu2 = 0) across it.
       fdir1 is expressed in base_link so it does not spin with the wheel. Needs the DART physics engine. -->
  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1</mu>
            <mu2>0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1</mu>
            <mu2>0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1</mu>
            <mu2>0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1</mu>
            <mu2>0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
  <gazebo>
    <!-- 4-wheel mecanum kinematics: listens to Twist on /cmd_vel (vx, vy, wz), publishes /odom and odom->base_link tf -->
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.596</wheel_separation>
      <wheelbase>0.403799</wheelbase>
      <wheel_radius>0.0635</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <!-- publishes every joint (4 wheels + 2 due units) so robot_state_publisher can draw the tf tree -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <!-- the two due units stay independent velocity-controlled joints (rad/s) -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>front_due_joint</joint_name>
      <topic>/due_wheel/front_due_joint/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>back_due_joint</joint_name>
      <topic>/due_wheel/back_due_joint/cmd_vel</topic>
    </plugin>
  </gazebo>
</robot>
